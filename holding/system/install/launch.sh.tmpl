#!/usr/bin/env bash
# Generated by write_company_launch.sh — company SoT entry (always CEO).
# Default: NEW git worktree. Docs: agents-holding docs/ceo-launch-and-children.md
set -euo pipefail
COMP="$(cd "$(dirname "$0")" && pwd)"
ROOT="@@PKG@@"
CORE="@@CORE@@"
HOP="$COMP/system/skills/defaults/marlin-hop/scripts/handoff_child.py"
EXTRA=()
POS=()
args=("$@")
i=1
while [[ $i -le $# ]]; do
  a="${args[$((i-1))]}"
  case "$a" in
    --continue|-c) EXTRA+=(--continue); i=$((i+1)) ;;
    --no-worktree) EXTRA+=(--no-worktree); i=$((i+1)) ;;
    --fresh) EXTRA+=(--fresh); i=$((i+1)) ;;
    --worktree-name|--worktree)
      if [[ $i -lt $# ]]; then EXTRA+=(--worktree-name "${args[$i]}"); i=$((i+2))
      else EXTRA+=(--worktree-name); i=$((i+1)); fi ;;
    -h|--help)
      echo "Usage: ./@@REL@@/launch.sh <grok|claude|codex|merge> [--worktree-name N|--no-worktree|--continue] [child?] [prompt]"
      exit 0 ;;
    *) POS+=("$a"); i=$((i+1)) ;;
  esac
done
set -- "${POS[@]+"${POS[@]}"}"
[[ $# -ge 1 ]] || {
  echo "Usage: ./@@REL@@/launch.sh <grok|claude|codex|merge> [--worktree-name N|--no-worktree|--continue] [child?] [prompt]" >&2
  exit 2
}
MODE="$1"; shift
if [[ $# -ge 1 && -f "$HOP" ]] && python3 "$HOP" "$1" --print-path >/dev/null 2>&1; then
  CDIR="$(python3 "$HOP" "$1" --print-path)"; shift
  COMP="$CDIR"
  if [[ "$(basename "$(dirname "$CDIR")")" == ".agents" ]]; then
    ROOT="$(cd "$CDIR/../.." && pwd)"
  fi
fi
PROMPT="$*"
exec bash "$CORE" --company-dir "$COMP" --root "$ROOT" "${EXTRA[@]+"${EXTRA[@]}"}" "$MODE" ${PROMPT:+"$PROMPT"}
